
page {
  background: linear-gradient(180deg, #07111f 0%, #071829 42%, #09101b 100%);
  color: #ffffff;
  min-height: 100%;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

view, text, button, input, slider {
  box-sizing: border-box;
}

button::after {
  border: none;
}

.page-shell {
  min-height: 100vh;
  padding: 0 24rpx 34rpx;
  position: relative;
  overflow: hidden;
}

.top-bg {
  position: fixed;
  left: -120rpx;
  top: -180rpx;
  width: 1080rpx;
  height: 860rpx;
  background: radial-gradient(circle at 32% 28%, rgba(46, 232, 182, 0.46), rgba(16, 72, 132, 0.15) 40%, rgba(7, 17, 31, 0) 72%);
  z-index: 0;
}

.top-bg::after {
  content: '';
  position: absolute;
  right: 80rpx;
  top: 110rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 207, 104, 0.22), rgba(255, 207, 104, 0));
}

.nav-safe {
  height: 72rpx;
}

.glass-card,
.header-card,
.section-card,
.metric-card,
.action-btn,
.connect-panel {
  position: relative;
  z-index: 1;
}

.glass-card {
  border: 1rpx solid rgba(255, 255, 255, 0.10);
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.11), rgba(255, 255, 255, 0.04));
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.20);
  backdrop-filter: blur(18rpx);
  border-radius: 28rpx;
}

.header-card {
  min-height: 220rpx;
  padding: 30rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, rgba(6, 29, 56, 0.94), rgba(10, 72, 90, 0.62)), linear-gradient(90deg, rgba(46, 232, 182, 0.20), rgba(255, 191, 87, 0.10));
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  overflow: hidden;
}

.header-card::after {
  content: '';
  position: absolute;
  width: 280rpx;
  height: 280rpx;
  right: -66rpx;
  bottom: -84rpx;
  border-radius: 50%;
  border: 34rpx solid rgba(46, 232, 182, 0.14);
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.brand-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #2ee8b6;
  box-shadow: 0 0 22rpx #2ee8b6;
}

.brand-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.76);
  letter-spacing: 4rpx;
}

.brand-title {
  display: block;
  font-size: 48rpx;
  line-height: 1.16;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.brand-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.52;
  color: rgba(255, 255, 255, 0.74);
}

.header-right {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  align-items: flex-end;
}

.connect-badge,
.header-chip,
.mini-tag,
.time-text {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.76);
  background: rgba(255, 255, 255, 0.10);
}

.connect-badge {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.signal-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #919eb2;
}

.connect-badge.online .signal-dot {
  background: #2ee8b6;
  box-shadow: 0 0 16rpx #2ee8b6;
}

.connect-badge.warn .signal-dot {
  background: #ffbf57;
  box-shadow: 0 0 16rpx #ffbf57;
}

.connect-badge.danger .signal-dot {
  background: #ff5d5d;
  box-shadow: 0 0 16rpx #ff5d5d;
}

.connect-panel {
  margin-top: 18rpx;
  padding: 18rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.input-wrap {
  flex: 1;
  height: 94rpx;
  padding: 10rpx 18rpx;
  border-radius: 22rpx;
  background: rgba(7, 17, 31, 0.44);
}

.input-label {
  display: block;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.48);
}

.ip-input {
  height: 50rpx;
  font-size: 30rpx;
  color: #ffffff;
}

.placeholder {
  color: rgba(255, 255, 255, 0.30);
}

.connect-btn,
.disconnect-btn,
.outline-btn,
.solid-btn {
  min-width: 146rpx;
  height: 92rpx;
  padding: 0 20rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
  text-align: center;
}

.connect-btn,
.solid-btn {
  color: #06121f;
  background: linear-gradient(135deg, #2ee8b6, #a4ffe1);
}

.disconnect-btn,
.outline-btn {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.10);
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
}

.section-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.56);
}

.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.grid-3 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
}

.metric-card,
.section-card {
  padding: 24rpx;
}

.metric-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.60);
}

.metric-value-row {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  margin-top: 16rpx;
}

.metric-value {
  font-size: 50rpx;
  line-height: 1;
  font-weight: 900;
}

.metric-unit {
  font-size: 22rpx;
  color: rgba(255,255,255,0.60);
}

.metric-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 20rpx;
  color: rgba(255,255,255,0.54);
}

.pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.pill {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,0.82);
  background: rgba(255,255,255,0.08);
}

.warn-pill {
  color: #06121f;
  background: linear-gradient(135deg, #ffcf68, #ffe9a8);
}

.good-pill {
  color: #06121f;
  background: linear-gradient(135deg, #2ee8b6, #a6ffe1);
}

.bottom-space { height: 50rpx; }


/* V7 双适配：平板展示优先 + 手机兼容 */
.page-shell.phone-mode {
  padding-left: 22rpx;
  padding-right: 22rpx;
}

.page-shell.pad-mode {
  padding-left: 34rpx;
  padding-right: 34rpx;
}

.phone-mode .header-card {
  flex-direction: column;
  min-height: auto;
}

.phone-mode .header-right {
  align-items: flex-start;
  flex-direction: row;
  flex-wrap: wrap;
}

.phone-mode .brand-title {
  font-size: 44rpx;
}

.phone-mode .brand-desc {
  font-size: 23rpx;
}

.phone-mode .grid-2,
.phone-mode .grid-3 {
  grid-template-columns: 1fr;
}

.pad-mode .grid-2 {
  grid-template-columns: 1fr 1fr;
}

.pad-mode .grid-3 {
  grid-template-columns: repeat(3, 1fr);
}

.phone-mode .section-head {
  align-items: flex-start;
  flex-direction: column;
}

.pad-mode .section-head {
  align-items: center;
  flex-direction: row;
}

.phone-mode .connect-panel {
  flex-direction: column;
  align-items: stretch;
}

.phone-mode .connect-btn,
.phone-mode .disconnect-btn {
  width: 100%;
}

.pad-mode .connect-panel {
  flex-direction: row;
  align-items: center;
}

.pad-mode .connect-btn,
.pad-mode .disconnect-btn {
  width: auto;
}
