# 默认按文本处理，LF 入库
* text=auto eol=lf

*.js   text eol=lf
*.json text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.c    text eol=lf
*.h    text eol=lf
*.ini  text eol=lf
*.wxml text eol=lf
*.wxss text eol=lf

# Windows / Shell 脚本
*.bat  text eol=crlf
*.sh   text eol=lf

# 二进制
*.png binary
*.jpg binary
*.jpeg binary
